# Copy to .env.local to override defaults.
# Run against the real backend (default). In dev, Vite proxies /api to http://127.0.0.1:5001.
# Set VITE_API_URL only when the API is hosted on a different origin:
# VITE_API_URL=https://your-api.example.com/api

# Run entirely on in-memory sample data (no backend needed):
# VITE_DEMO_MODE=true
