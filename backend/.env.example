# Copy to .env and fill in. Never commit the real .env.
APP_ENV=development
# openssl rand -hex 32 (REQUIRED when APP_ENV=production)
JWT_SECRET_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
# Defaults to a local SQLite file. Use PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/ledger
DATABASE_URL=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enables passwordless /api/auth/demo (only for demo deployments)
DEMO_LOGIN_ENABLED=false
# Optional: enables the Ask Ledger AI assistant
GEMINI_API_KEY=
